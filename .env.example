# Cloud (sync) database used by the Next.js API routes.
# Never commit the real .env file.
DATABASE_URL=postgresql://user:password@host:5432/database

# Origin loaded by the Capacitor Android shell (your deployed app URL).
CAP_SERVER_URL=https://todo.example.com

# If you deploy the cloud tier on Supabase instead of plain PostgreSQL, the
# anon key is the ONLY key that may ever reach a client bundle.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY must stay server-side only. Never ship it.
